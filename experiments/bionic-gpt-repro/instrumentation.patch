diff --git a/crates/web-server/afg_probe.rs b/crates/web-server/afg_probe.rs
new file mode 100644
index 0000000..136e740
--- /dev/null
+++ b/crates/web-server/afg_probe.rs
@@ -0,0 +1,88 @@
+// AFG dynamic instrumentation probe.
+//
+// Added for the AFG (Access Flow Guard) access-flow experiment. This is the probe
+// the AFG instrumenter injects at the sites the static analysis flags (the auth
+// point and the shared data-store accesses). It is added by hand to the real
+// bionic source here so the unmodified app logic runs and produces the AFG JSONL
+// trace that afg_observe analyzes.
+//
+// It reads AFG_TRACE_PATH (a fresh file is written per process start). When the
+// variable is unset every call is a cheap no-op, so a normal build carries no
+// behavioural change.
+use serde_json::json;
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+
+// PANode label for the shared conversation/chat store (llm.chats). AFG's static
+// analysis flags this as the resource reached by more than one principal; the
+// dynamic trace tags each access to it so afg_observe can decide leaks per
+// conversation instance.
+pub const NODE_CHATS: u64 = 7100;
+
+struct Trace {
+    file: Mutex<File>,
+    seq: Mutex<u64>,
+}
+
+static TRACE: OnceLock<Option<Trace>> = OnceLock::new();
+
+fn trace() -> Option<&'static Trace> {
+    TRACE
+        .get_or_init(|| {
+            let path = std::env::var("AFG_TRACE_PATH").ok()?;
+            let file = OpenOptions::new()
+                .create(true)
+                .write(true)
+                .truncate(true)
+                .open(path)
+                .ok()?;
+            Some(Trace {
+                file: Mutex::new(file),
+                seq: Mutex::new(0),
+            })
+        })
+        .as_ref()
+}
+
+fn emit(mut event: serde_json::Value) {
+    if let Some(t) = trace() {
+        let seq = {
+            let mut s = t.seq.lock().expect("afg seq lock");
+            *s += 1;
+            *s
+        };
+        event["seq"] = json!(seq);
+        let mut f = t.file.lock().expect("afg trace lock");
+        let _ = writeln!(f, "{}", event);
+    }
+}
+
+/// Record the authenticated principal established at the request auth point.
+pub fn auth(principal: &str, method: &str) {
+    emit(json!({
+        "event": "auth",
+        "principal": principal,
+        "method": method,
+        "permissions": [],
+        "duration_ms": null,
+    }));
+}
+
+/// Record an access to a shared store. `resource` names the instance touched
+/// (e.g. "conversation:1") and `count` the rows it actually yielded, so a read
+/// dominated by an ownership check (count 0) is distinguishable from one that
+/// served the instance's data.
+#[allow(clippy::too_many_arguments)]
+pub fn access(principal: &str, node: u64, kind: &str, resource: &str, count: u64, file: &str, line: u32) {
+    emit(json!({
+        "event": "access",
+        "principal": principal,
+        "node": node,
+        "kind": kind,
+        "resource": resource,
+        "count": count,
+        "file": file,
+        "line": line,
+    }));
+}
