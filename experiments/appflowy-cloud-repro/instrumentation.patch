--- a/src/api/workspace.rs
+++ b/src/api/workspace.rs
@@ -1240,6 +1240,7 @@ async fn get_collab_handler(
     .validate()
     .map_err(|err| AppError::InvalidRequest(err.to_string()))?;
 
+  crate::afg_probe::auth(&uid.to_string(), "gotrue");
   let encode_collab = state
     .collab_storage
     .get_full_encode_collab(
@@ -1252,6 +1253,17 @@ async fn get_collab_handler(
     .map_err(AppResponseError::from)?
     .encoded_collab;
 
+  // Reached only after the casbin ownership check passed; the read served data.
+  crate::afg_probe::access(
+    &uid.to_string(),
+    crate::afg_probe::NODE_COLLAB,
+    "Read",
+    &format!("collab:{}", params.object_id),
+    encode_collab.doc_state.len() as u64,
+    file!(),
+    line!(),
+  );
+
   let resp = CollabResponse {
     encode_collab,
     object_id: params.object_id,
@@ -1920,12 +1932,28 @@ async fn batch_get_collab_handler(
     .get_user_uid(&user_uuid)
     .await
     .map_err(AppResponseError::from)?;
+  crate::afg_probe::auth(&uid.to_string(), "gotrue");
   let result = BatchQueryCollabResult(
     state
       .collab_storage
       .batch_get_collab(&uid, workspace_id, payload.into_inner().0)
       .await,
   );
+  // This batch path performs no per-object ownership check, so whatever it served
+  // is recorded as a read of that collab instance by the current principal.
+  for (object_id, res) in result.0.iter() {
+    if let database_entity::dto::QueryCollabResult::Success { encode_collab_v1 } = res {
+      crate::afg_probe::access(
+        &uid.to_string(),
+        crate::afg_probe::NODE_COLLAB,
+        "Read",
+        &format!("collab:{}", object_id),
+        encode_collab_v1.len() as u64,
+        file!(),
+        line!(),
+      );
+    }
+  }
   Ok(Json(AppResponse::Ok().with_data(result)))
 }
 
