# Copy to `.env` and fill in ONE key. Whichever is present is used; if neither is
# set, the demo falls back to a canned answer.
#
# Google Gemini (free tier at https://aistudio.google.com/apikey, no card needed):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Groq (free key at https://console.groq.com/keys):
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
